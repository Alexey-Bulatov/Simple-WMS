[Unit]
Description=Simple WMS PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=wms
WorkingDirectory=/opt/simple-wms
EnvironmentFile=/opt/simple-wms/.env
Environment=WMS_BACKUP_DIR=/var/backups/simple-wms
Environment=WMS_BACKUP_RETENTION_DAYS=14
ExecStart=/opt/simple-wms/.venv/bin/python -m scripts.backup_database
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
