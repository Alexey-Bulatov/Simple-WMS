APP_NAME=Simple WMS
APP_ENV=development
DATABASE_URL=sqlite:///./wms.db
AUTH_ENFORCEMENT_ENABLED=false
AUTH_SESSION_HOURS=12
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_MINUTES=15
AUTH_COOKIE_SECURE=false
# AUTH_BOOTSTRAP_TOKEN=set-only-for-remote-bootstrap
THERMAL_PRINTER_QUEUE=ATOL_TT42
THERMAL_PRINTER_HOST=printer.local
THERMAL_PRINTER_PORT=9100
WMS_BACKUP_DIR=/var/backups/simple-wms
WMS_BACKUP_RETENTION_DAYS=14
